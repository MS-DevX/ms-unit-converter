    "category_id": "algebra",
    "topic": "Quadratic Equations",
    "name": "Discriminant Formula",
    "formula": "Δ = b² - 4ac",
    "description": "Determines the number and nature of roots for a quadratic equation ax² + bx + c = 0.",
    "difficulty": 1,
    "estimated_read_minutes": 2,
    "variables": [
      { "symbol": "Δ", "name": "Discriminant", "description": "Determines nature of roots (Δ > 0: two real, Δ = 0: one real, Δ < 0: two complex)" },
      { "symbol": "a", "name": "Coefficient of x²", "description": "Non-zero multiplier of x²" },
      { "symbol": "b", "name": "Coefficient of x", "description": "Multiplier of x" },
      { "symbol": "c", "name": "Constant", "description": "Constant term" }
    ],
    "worked_example": {
      "problem": "Determine the nature of roots for x² + 2x + 5 = 0.",
      "steps": [
        "Identify a = 1, b = 2, c = 5.",
        "Calculate Δ = (2)² - 4(1)(5) = 4 - 20 = -16.",
        "Since Δ < 0, the equation has no real roots and two complex conjugate solutions."
      ],
      "solution": "Δ = -16 (Two distinct complex roots)"
    },
    "related_content": [
      { "target_type": "formula", "target_id": "101", "title": "Quadratic Formula", "relationship_type": "parent" }
    ],
    "search_keywords": ["discriminant", "delta", "roots", "nature of roots"],
    "display_order": 2,
    "tags": ["algebra", "quadratic"]
  },
