    "estimated_read_minutes": 2,
    "variables": [
      { "symbol": "a", "name": "Leg A", "description": "Length of first perpendicular leg" },
      { "symbol": "b", "name": "Leg B", "description": "Length of second perpendicular leg" },
      { "symbol": "c", "name": "Hypotenuse", "description": "Length of side opposite the right angle" }
    ],
    "worked_example": {
      "problem": "Find the hypotenuse c of a right triangle with leg lengths a = 6 cm and b = 8 cm.",
      "steps": [
        "Square both leg lengths: 6² = 36, 8² = 64.",
        "Add squares: 36 + 64 = 100.",
        "Take square root of sum: c = √100 = 10 cm."
      ],
      "solution": "c = 10 cm"
    },
