    "topic": "Triangles & Ratios",
    "name": "Law of Sines",
    "formula": "a / sin(A) = b / sin(B) = c / sin(C)",
    "description": "Relates the side lengths of any oblique triangle to the sines of its interior angles.",
    "difficulty": 2,
    "estimated_read_minutes": 3,
    "variables": [
      { "symbol": "a, b, c", "name": "Side Lengths", "description": "Opposite sides of angles A, B, C" },
      { "symbol": "A, B, C", "name": "Interior Angles", "description": "Opposite angles of sides a, b, c" }
    ],
    "worked_example": {
      "problem": "In triangle ABC, side a = 10, angle A = 30°, and angle B = 45°. Find side b.",
      "steps": [
        "Set up equation: 10 / sin(30°) = b / sin(45°).",
        "Know values: sin(30°) = 0.5, sin(45°) = √2 / 2 ≈ 0.7071.",
        "Solve for b: 10 / 0.5 = b / 0.7071 ⇒ 20 = b / 0.7071.",
        "Multiply: b = 20 × 0.7071 = 14.14."
      ],
      "solution": "b ≈ 14.14"
    },
    "related_content": [
      { "target_type": "formula", "target_id": "302", "title": "Law of Cosines", "relationship_type": "complement" }
