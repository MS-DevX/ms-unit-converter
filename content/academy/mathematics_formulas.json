  {
    "id": 101,
    "subject_id": 1,
    "category_id": "algebra",
    "topic": "Quadratic Equations",
    "name": "Quadratic Formula",
    "formula": "x = (-b ± √(b² - 4ac)) / (2a)",
    "description": "Calculates the real or complex roots of any second-degree polynomial equation in the standard form ax² + bx + c = 0.",
    "difficulty": 2,
    "estimated_read_minutes": 3,
    "variables": [
      { "symbol": "a", "name": "Quadratic Coefficient", "description": "Coefficient of x² (must be non-zero)" },
      { "symbol": "b", "name": "Linear Coefficient", "description": "Coefficient of x" },
      { "symbol": "c", "name": "Constant Term", "description": "Numerical constant term" },
      { "symbol": "x", "name": "Roots / Solutions", "description": "Values of x where the equation equals 0" }
    ],
    "worked_example": {
      "problem": "Solve 2x² - 4x - 6 = 0 using the quadratic formula.",
      "steps": [
        "Identify coefficients: a = 2, b = -4, c = -6.",
        "Compute the discriminant: Δ = b² - 4ac = (-4)² - 4(2)(-6) = 16 + 48 = 64.",
        "Apply quadratic formula: x = (-(-4) ± √64) / (2 × 2) = (4 ± 8) / 4.",
        "Calculate roots: x₁ = (4 + 8) / 4 = 3, and x₂ = (4 - 8) / 4 = -1."
      ],
      "solution": "x = 3 or x = -1"
    },
    "related_content": [
      { "target_type": "formula", "target_id": "102", "title": "Discriminant Formula", "relationship_type": "prerequisite" },
      { "target_type": "formula", "target_id": "103", "title": "Vertex Form of Parabola", "relationship_type": "extension" }
    ],
    "search_keywords": ["quadratic", "roots", "parabola", "equation", "formula", "algebra"],
    "display_order": 1,
    "tags": ["algebra", "polynomials", "equations"]
  },
  {
    "id": 102,
