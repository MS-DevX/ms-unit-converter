        { "symbol": "π", "name": "Pi Constant", "description": "Mathematical constant ≈ 3.14159" }
      ],
      "worked_example": {
        "problem": "Calculate the area of a circle with radius r = 7 cm",
        "steps": [
          "r² = 7² = 49",
          "A = π × 49 ≈ 3.14159 × 49 = 153.94 cm²"
        ],
        "solution": "A ≈ 153.94 cm²"
      },
