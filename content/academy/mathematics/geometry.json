      "name": "Area of a Circle",
      "formula": "A = π * r^2",
      "description": "Calculates the total two-dimensional surface space inside a circle of radius r.",
      "difficulty": "beginner",
      "estimated_read_minutes": 2,
      "display_order": 2,
      "variables": [
        { "symbol": "A", "name": "Area", "description": "Total surface area of circle" },
