          { "symbol": "b", "label": "Leg b", "default_value": 4.0, "example_value": 4.0, "unit": "cm", "validation": { "min": 0.0, "allow_zero": false, "allow_negative": false } }
        ],
        "outputs": [
          { "symbol": "c", "label": "Hypotenuse", "unit": "cm" }
        ]
      },
      "sections": [
