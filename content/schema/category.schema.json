{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STEM Category File Schema",
  "description": "Schema for individual modular category content files.",
  "type": "object",
  "properties": {
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject_id": { "type": "string" },
        "name": { "type": "string" },
        "emoji": { "type": "string" },
        "description": { "type": "string" },
        "display_order": { "type": "integer" }
      },
      "required": ["id", "subject_id", "name", "emoji", "description", "display_order"]
    },
    "lessons": {
      "type": "array",
      "items": {
        "$ref": "lesson.schema.json"
      }
    }
  },
  "required": ["category", "lessons"]
}
