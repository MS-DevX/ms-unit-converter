{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Academy Content Manifest Schema",
  "description": "Schema for top-level and subject content manifest files in STEM Academy.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "manifest_path": { "type": "string" },
          "is_available": { "type": "boolean" }
        },
        "required": ["id", "manifest_path"]
      }
    },
    "subject_id": {
      "type": "string"
    },
    "subject_name": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "file": { "type": "string" },
          "name": { "type": "string" },
          "emoji": { "type": "string" }
        },
        "required": ["id", "file", "name"]
      }
    }
  }
}
