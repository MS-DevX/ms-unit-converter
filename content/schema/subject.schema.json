{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "STEM Subject Schema",
  "description": "Schema for individual subject metadata objects.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "numeric_id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "is_available": {
      "type": "boolean"
    },
    "display_order": {
      "type": "integer"
    }
  },
  "required": ["id", "numeric_id", "name", "icon", "is_available", "display_order"]
}
